{
  "name": "graph-uniswap-mcp",
  "version": "0.3.3",
  "description": "Uniswap MCP over The Graph \u2014 V2/V3/V4 on 6 chains. Simulates swaps offline with the protocol's own concentrated-liquidity math (wei-exact vs @uniswap/v3-sdk, no RPC, no extra key): amount out, effective price, price impact. Refuses to guess instead of shipping a wrong number.",
  "type": "module",
  "author": "PaulieB14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulieB14/graph-uniswap-mcp.git"
  },
  "homepage": "https://github.com/PaulieB14/graph-uniswap-mcp#readme",
  "bugs": {
    "url": "https://github.com/PaulieB14/graph-uniswap-mcp/issues"
  },
  "bin": {
    "graph-uniswap-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node test/smoke.mjs && node test/quote-math.mjs",
    "test:live": "npm run build && node test/stress.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "agents",
    "ai",
    "concentrated-liquidity",
    "defi",
    "dex",
    "mcp",
    "model-context-protocol",
    "onchain",
    "price-impact",
    "quote",
    "slippage",
    "subgraph",
    "swap",
    "the-graph",
    "thegraph",
    "uniswap",
    "uniswap-v3",
    "uniswap-v4",
    "v3",
    "v4"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
